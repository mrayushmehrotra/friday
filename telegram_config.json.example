        "4. Paste token + chat id below, then run: python institution_telegram_bot.py --test"
    ],
    "bot_token": "123456789:AAExampleTokenFromBotFather",
    "chat_id": "123456789",
    "poll_interval_min": 30,
    "max_deal_age_days": 10
